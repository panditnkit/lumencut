# Copy to .env and replace every placeholder before starting the backend.
ADMIN_USERNAME=
ADMIN_PASSWORD=
APP_SECRET=

# Local server values. For a hosted backend, set the public HTTPS URLs.
HOST=127.0.0.1
PORT=3000
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://panditnkit.github.io
LUMENCUT_DATA_DIR=./data

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=7200

# Add provider credentials only to the backend .env / secret manager.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/youtube/callback
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/oauth/instagram/callback
META_GRAPH_VERSION=v22.0
